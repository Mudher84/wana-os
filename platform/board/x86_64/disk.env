# Fixed identifiers of the Wana OS disk image. Shared by post-image.sh
# (image creation) and tools/ (tests). Fixed values keep the image
# reproducible; the installer generates fresh ones for real installations.
WANA_DISK_GUID=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a000
WANA_ESP_PARTUUID=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a0e5
WANA_ROOT_PARTUUID=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a001
WANA_ROOT_A_PARTUUID=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a001
WANA_DATA_PARTUUID=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a002
WANA_ROOT_B_PARTUUID=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a003
WANA_ROOT_SLOT_SIZE=768M
# ext4 root filesystem UUID and directory hash seed. mkfs.ext4 picks random
# ones otherwise. The values are set in wana_x86_64_defconfig
# (BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS); tools/check-repo.sh keeps both in sync.
WANA_ROOT_FS_UUID=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a0f5
WANA_ROOT_FS_HASH_SEED=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a0f6
WANA_DATA_FS_UUID=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a0d5
WANA_DATA_FS_HASH_SEED=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a0d6
# FAT volume serial of the ESP (8 hex digits).
WANA_ESP_VOLID=57414e41
WANA_ESP_OFFSET=1M
