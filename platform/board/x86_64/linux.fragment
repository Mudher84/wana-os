# Wana OS kernel configuration fragment, applied on top of x86_64_defconfig.
# Every line here is verified against the final .config by
# tools/check-kernel-config.sh, because Kconfig silently drops options whose
# dependencies are not met.

CONFIG_LOCALVERSION="-wana"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Boot: UEFI stub, early devtmpfs, serial console --------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Virtualization targets (QEMU/KVM bring-up and CI) -------------------
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- Common physical Ethernet controllers (Phase 28) -----------------------
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_R8169=y

# --- Graphics: DRM/KMS (Phase 7) -----------------------------------------
# simpledrm drives the firmware (UEFI GOP) framebuffer until a native
# driver takes over; virtio-gpu is the native KMS driver under QEMU.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_I915=y
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_RADEON=y
CONFIG_DRM_FBDEV_EMULATION=y

# --- Input (Phase 9): evdev for libinput, USB/virtio HID ------------------
CONFIG_INPUT_EVDEV=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_XHCI_HCD=y

# --- Storage and filesystems: installed disk, ESP, live ISO ---------------
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_USB_STORAGE=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# --- Audio (Phase 31) ------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB_AUDIO=y

# --- Bluetooth (Phase 32) --------------------------------------------------
CONFIG_USB=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y

# --- Compatibility containers / Android foundation (Phase 34) -------------
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_PSI=y
CONFIG_KEYS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_MACVLAN=y
CONFIG_TUN=y
CONFIG_NETFILTER=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# --- Console hygiene -------------------------------------------------------
# x86_64_defconfig enables stack-usage debugging, which prints
# "<task> used greatest stack depth" on process exit at random moments. On
# the serial console that line can split a userspace log line in two
# (CI run 36157632246: "[INIT] info: /us[ 6.50] wana-kms ... r/bin/wana-kms").
# Stack-usage instrumentation is a debugging aid, not needed in Wana images.
# CONFIG_DEBUG_STACK_USAGE is not set

# --- Isolation primitives for services and app sandboxing -----------------
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y

CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y