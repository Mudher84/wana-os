BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_WANA_PATH)/board/x86_64/users.table"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_WANA_PATH)/board/x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_WANA_PATH)/board/x86_64/post-image.sh"
