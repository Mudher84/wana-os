# BR2_PACKAGE_EUDEV_ENABLE_HWDB is not set
BR2_PACKAGE_WAYLAND_UTILS=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_ZSTD=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="wana-root"
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit -U 5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a0f5 -E hash_seed=5d9f6a52-7e1b-4c3a-9b8e-0a1a57a0a0f6"
