config BR2_PACKAGE_WANA_TEXT
	bool "wana-text"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_INSTALL_LIBSTDCPP # harfbuzz
	depends on BR2_TOOLCHAIN_HAS_SYNC_4 # harfbuzz
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 # harfbuzz
	select BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_FREETYPE # harfbuzz font loading; rasterization later
	select BR2_PACKAGE_HARFBUZZ
	select BR2_PACKAGE_LIBFRIBIDI
	select BR2_PACKAGE_WANA_FONTS
	help
	  Wana OS text (decision 0002): the pinned UI fonts verified
	  against SHA256SUMS and loaded through HarfBuzz, shaping
	  (HarfBuzz) and BiDi (FriBidi); layout follows. Installs
	  the wana-text bring-up tool.

comment "wana-text needs a toolchain w/ C++, gcc >= 4.9"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_GCC_AT_LEAST_4_9
