#!/bin/sh
set -eu

target=${1:-/data}
fstype=$(awk -v target="$target" '$2 == target { print $3; exit }' /proc/mounts)
case "$fstype" in
    ext4)
        echo "WANA_DATA_GROW_CHECK target=$target fstype=ext4"
        exec /usr/bin/embiggen-disk "$target"
        ;;
    *)
        echo "WANA_DATA_GROW_SKIP target=$target fstype=${fstype:-unknown}"
        exit 0
        ;;
esac
