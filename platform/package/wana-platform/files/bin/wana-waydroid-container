#!/bin/sh
set -eu

work=/var/lib/waydroid
config="$work/waydroid.cfg"
rootfs="$work/rootfs"

if [ ! -f "$config" ] || [ ! -d "$rootfs" ]; then
    echo "WANA_ANDROID_CONTAINER_WAIT config=$config rootfs=$rootfs"
    while [ ! -f "$config" ] || [ ! -d "$rootfs" ]; do
        sleep 2
    done
fi

echo "WANA_ANDROID_CONTAINER_START config=$config rootfs=$rootfs"
exec /usr/bin/waydroid container start
