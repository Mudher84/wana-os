# Pinned Buildroot release. Read by the top-level Makefile and by
# tools/fetch-buildroot.sh. Changing Buildroot = changing these three lines.
# 2026.02.x is a Buildroot LTS series (one year of security/bug fixes).
BUILDROOT_VERSION=2026.02.3
BUILDROOT_COMMIT=679b9ead7620bbf193620d1ebf56f53c1764d37a
BUILDROOT_URL=https://github.com/buildroot/buildroot
